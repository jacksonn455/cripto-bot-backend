# Copy to .env and fill in. Never commit .env (it is git-ignored). Every variable has a safe
# default unless marked REQUIRED. Production (Oracle VM + PM2): see docs/DEPLOY_ORACLE.md.

# --- App ---
# production on the VM (PM2 also sets it via `--env production`).
NODE_ENV=development
# Nginx on the VM proxies to 127.0.0.1:8000.
PORT=8000
# 127.0.0.1 (default) = reachable only from this machine — on the VM, only through Nginx.
# 0.0.0.0 = reachable from the network (the Dockerfile sets it for containers).
HOST=127.0.0.1
LOG_LEVEL=info
# Browser origins allowed to call the API directly (comma-separated, exact origins, never "*").
# Empty = CORS off, which is correct while the dashboard calls the API server-side through its
# /api/backend proxy. Example: https://your-app.vercel.app,http://localhost:3000
CORS_ORIGINS=

# --- MongoDB ---
# REQUIRED when NODE_ENV=production (the boot fails without it).
# Atlas: mongodb+srv://USER:PASS@cluster.xxxx.mongodb.net/DB_NAME?retryWrites=true&w=majority
# (always include DB_NAME, otherwise Mongo uses "test"). `pnpm seed` refuses non-local URIs.
MONGO_URI=mongodb://mongo:27017/trade-bot

# --- Trading safety switches (see README "Risk disclaimer") ---
# PAPER = simulated only, no real orders are ever sent. This is the default and recommended mode.
# LIVE  = enables real order placement IF LIVE_TRADING_CONFIRMED=true. Combine with a
#         production BINANCE_BASE_URL only when you fully understand the risk.
TRADING_MODE=PAPER
LIVE_TRADING_CONFIRMED=false

# --- Binance ---
# Required only when TRADING_MODE=LIVE. Never commit real keys. Use an API key WITHOUT withdrawal permission.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_BASE_URL=https://testnet.binance.vision
BINANCE_WS_BASE_URL=wss://testnet.binance.vision
BINANCE_RECV_WINDOW=5000

# Read-only price feed for PAPER mode/backtests (public endpoints, no keys, no risk).
# Defaults to real production data so simulated fills reflect real market prices,
# independent of BINANCE_BASE_URL above (which is only where real orders are routed).
# If the host gets HTTP 451/403 (region block), use the public market-data mirror instead:
# MARKET_DATA_BASE_URL=https://data-api.binance.vision
MARKET_DATA_BASE_URL=https://api.binance.com
# Per Binance HTTP call. Idempotent reads (candles, exchange info) retry network errors/5xx twice.
BINANCE_HTTP_TIMEOUT_MS=15000

# --- Paper trading simulated balance ---
PAPER_INITIAL_BALANCE_ASSET=USDT
PAPER_INITIAL_BALANCE_AMOUNT=10000
# false (default) = PAPER can't short, exactly like LIVE on Binance Spot. true = PAPER simulates shorts
# (no borrow/funding/liquidation): trades LIVE could never make, for research only.
PAPER_SIMULATED_SHORTS=false

# --- Strategy (TrendRegimeStrategy) ---
# TREND_SYMBOLS=BTCUSDT,ETHUSDT
# TREND_TIMEFRAME=1h
# TREND_REGIME_TIMEFRAME=4h
# true = the strategy also emits SHORT signals (exact mirror of the long rules). Off by default:
# compare in a backtest first (strategyParams: { "allowShort": 1 }). Binance Spot (LIVE) can't short,
# and PAPER mirrors it by default: risk vetoes shorts with SHORT_NOT_SUPPORTED in both (the vetoed
# shorts still appear in the candidate ledger). See PAPER_SIMULATED_SHORTS to simulate them in PAPER.
TREND_ALLOW_SHORT=true
# Research filters, off (0) by default: test them in a backtest (strategyParams) before turning on.
# ADX(TREND_ADX_PERIOD) on the regime timeframe must be >= TREND_ADX_MIN to enter (E5: 20).
# TREND_ADX_PERIOD=14
# TREND_ADX_MIN=0
# Regime band: up only when close > EMA × (1 + band), down only below EMA × (1 − band). 0.01 = 1%.
# TREND_REGIME_BAND_PCT=0

# Indicator parameters (defaults shown; change only after a backtest).
# TREND_EMA_FAST=20
# TREND_EMA_SLOW=50
# TREND_EMA_REGIME=200
# TREND_RSI_PERIOD=14
# TREND_RSI_MIN=45
# TREND_RSI_MAX=70
# TREND_ATR_PERIOD=14
# TREND_ATR_STOP_MULT=2
# TREND_CHANDELIER_LOOKBACK=22
# TREND_CHANDELIER_ATR_MULT=3

# --- RiskManager (defaults shown) ---
# RISK_PER_TRADE_PCT=0.01
# RISK_MAX_OPEN_POSITIONS=3
# RISK_MAX_EXPOSURE_PER_ASSET_PCT=0.3
# RISK_MAX_TOTAL_EXPOSURE_PCT=0.6
# RISK_MAX_DAILY_LOSS_PCT=0.03
# RISK_MAX_CONSECUTIVE_STOPS=3
# RISK_MIN_RR_RATIO=1.5
# RISK_MIN_VOLUME_24H=0
# RISK_MAX_SPREAD_PCT=100

# --- ExecutionModule ---
# Off by default even in PAPER mode — an extra explicit opt-in before the automated loop runs.
EXECUTION_ENABLED=false
EXECUTION_POLL_INTERVAL_SECONDS=60
EXECUTION_RECONCILIATION_INTERVAL_MINUTES=15
EXECUTION_STOP_LIMIT_OFFSET_PCT=0.001
# PAPER/LIVE equity curve: one snapshot (cash + open positions at last price) every N minutes.
EQUITY_SNAPSHOT_INTERVAL_MINUTES=5
# A single symbol evaluation taking longer than this is abandoned (the loop moves on).
EXECUTION_SYMBOL_TIMEOUT_SECONDS=120
# Worker liveness: no heartbeat for this long = OFFLINE (watchdog alert; /health 503 when stalled).
WORKER_HEARTBEAT_TIMEOUT_SECONDS=300
# On restart, a gap longer than this is reported as downtime on Discord.
WORKER_DOWNTIME_ALERT_MINUTES=10

# --- ControlModule ---
# Required to call POST /bot/pause, /resume, /kill-switch via header X-Control-Api-Key.
# Leave empty during local dev; set it before exposing the API anywhere reachable.
CONTROL_API_KEY=
# true = EVERY route except /health needs X-Control-Api-Key (public host, e.g. the Oracle VM).
# Requires CONTROL_API_KEY (min 32 chars). The dashboard proxy already sends it.
API_KEY_REQUIRED_FOR_ALL=false
# false = no Swagger UI at /docs (recommended on a public host).
SWAGGER_ENABLED=true

# --- Notifications (optional) ---
# Every notification is always logged; channels below are extra. A channel failure (timeout, 5xx,
# rate limit) is logged and never affects trading.
# Discord: create a webhook (Server Settings > Integrations > Webhooks) and paste its URL.
# The URL contains a secret token: never commit it.
DISCORD_ENABLED=false
DISCORD_WEBHOOK_URL=
DISCORD_USERNAME=Trade Bot
# Comma-separated: alerts (critical/pause/resume), trades (opened/closed), reports (daily report,
# backtest finished) and/or signals (entry signals vetoed by risk, grouped).
DISCORD_EVENTS=alerts,trades,reports,signals
# Telegram: on as soon as token + chat id are set (TELEGRAM_ENABLED=false turns it off).
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_EVENTS=alerts
# Per HTTP attempt (Discord/Telegram).
NOTIFICATIONS_TIMEOUT_MS=5000
NOTIFICATIONS_TIME_ZONE=America/Sao_Paulo
# Operational incidents/recoveries (Binance, MongoDB, Redis, worker offline) on the Discord webhook.
DISCORD_ALERTS_ENABLED=true
# Same incident is re-sent at most once per cooldown.
DISCORD_ALERT_COOLDOWN_SECONDS=300
# Consecutive failures of a dependency before an incident is opened.
INCIDENT_FAILURE_THRESHOLD=3
# Label shown in alerts (defaults to NODE_ENV), e.g. PRODUCTION.
# KRYPTO_ENVIRONMENT=PRODUCTION
# Daily report (PnL, trades, equity, open positions, evaluations, worker state) at this local hour
# (NOTIFICATIONS_TIME_ZONE). Also works as the daily "still alive" heartbeat. Category: reports.
DAILY_REPORT_ENABLED=true
DAILY_REPORT_HOUR=8
# Risk-vetoed entry signals are grouped into one message per window (0 = one message per veto).
SIGNAL_VETO_DIGEST_MINUTES=60

# --- Funding scanner (read-only, never places orders) ---
FUNDING_SCAN_ENABLED=true
FUNDING_BASE_URL=https://fapi.binance.com

# --- Redis (cache for reports/charts, so dashboards don't hit Mongo on every request) ---
# Upstash (TLS): rediss://default:<UPSTASH_REDIS_REST_TOKEN>@<host>.upstash.io:6379 (Upstash
# console > Connect > ioredis). Local alternative: redis://localhost:6379 (or redis://redis:6379
# in Docker Compose). Purely a performance optimization: if Redis is down/unreachable, the app
# logs a warning and falls back to querying Mongo directly.
# Set it empty (REDIS_URL=) to disable the cache entirely.
REDIS_ENABLED=true
REDIS_URL=rediss://default:<upstash-token>@<your-db>.upstash.io:6379
REPORTS_CACHE_TTL_SECONDS=30
# A hung Redis costs at most this per request before falling back to Mongo.
REDIS_COMMAND_TIMEOUT_MS=500
REDIS_CONNECT_TIMEOUT_MS=2000
# Reconnect attempts (backoff up to 30s) before giving up; then one re-probe every 5 min.
REDIS_MAX_RECONNECT_ATTEMPTS=10

# --- Candidate ledger and judge (observability; docs/CANDIDATOS.md) ---
# Every triggered entry setup (accepted or rejected, with gates, features, risk/pause outcome) is
# stored in candidate_assessments. Never read for trading. false = nothing is written.
CANDIDATE_LEDGER_ENABLED=true
# Worker fills in "what if it had been traded" shadow outcomes every N minutes (0 = only on demand,
# POST /candidates/shadow/refresh).
CANDIDATE_SHADOW_REFRESH_MINUTES=60
# off (default) = no judge runs. shadow = the judge's assessment is stored on each candidate and never
# affects a decision. There is no mode in which a judge can change a trade.
AI_JUDGE_MODE=off
# noop (no opinion) or baseline (restates the deterministic rules). No LLM judge exists yet.
AI_JUDGE=noop
AI_JUDGE_TIMEOUT_MS=5000

# --- OpenAI Agents (optional: analysis/explanations only, never places or closes trades) ---
# POST /ai/agents/:agent/run (needs X-Control-Api-Key when CONTROL_API_KEY is set).
# Enabling without OPENAI_API_KEY makes the boot fail (fail-fast, like LIVE mode).
OPENAI_AGENTS_ENABLED=false
OPENAI_API_KEY=
# Empty = the Agents SDK default model.
OPENAI_MODEL=
OPENAI_REQUEST_TIMEOUT_MS=30000
OPENAI_MAX_RETRIES=2
OPENAI_AGENT_TIMEOUT_MS=90000
OPENAI_AGENT_MAX_TURNS=8
OPENAI_MAX_CONCURRENT_RUNS=2
# Off by default: traces would send prompts and trading data to the OpenAI dashboard.
OPENAI_TRACING_ENABLED=false
