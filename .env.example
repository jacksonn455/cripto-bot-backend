# --- App ---
NODE_ENV=development
PORT=8000
# 127.0.0.1 = API reachable only from this machine (recommended when the dashboard runs here too).
# 0.0.0.0 = reachable from the network / inside Docker.
HOST=0.0.0.0
LOG_LEVEL=info

# --- MongoDB ---
# Atlas: mongodb+srv://USER:PASS@cluster.xxxx.mongodb.net/DB_NAME?retryWrites=true&w=majority
# (always include DB_NAME, otherwise Mongo uses "test"). `pnpm seed` refuses non-local URIs.
MONGO_URI=mongodb://mongo:27017/trade-bot

# --- Trading safety switches (see README "Risk disclaimer") ---
# PAPER = simulated only, no real orders are ever sent. This is the default and recommended mode.
# LIVE  = enables real order placement IF LIVE_TRADING_CONFIRMED=true. Combine with a
#         production BINANCE_BASE_URL only when you fully understand the risk.
TRADING_MODE=PAPER
LIVE_TRADING_CONFIRMED=false

# --- Binance ---
# Required only when TRADING_MODE=LIVE. Never commit real keys. Use an API key WITHOUT withdrawal permission.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_BASE_URL=https://testnet.binance.vision
BINANCE_WS_BASE_URL=wss://testnet.binance.vision
BINANCE_RECV_WINDOW=5000

# Read-only price feed for PAPER mode/backtests (public endpoints, no keys, no risk).
# Defaults to real production data so simulated fills reflect real market prices,
# independent of BINANCE_BASE_URL above (which is only where real orders are routed).
MARKET_DATA_BASE_URL=https://api.binance.com

# --- Paper trading simulated balance ---
PAPER_INITIAL_BALANCE_ASSET=USDT
PAPER_INITIAL_BALANCE_AMOUNT=10000

# --- Strategy (TrendRegimeStrategy) ---
# TREND_SYMBOLS=BTCUSDT,ETHUSDT
# TREND_TIMEFRAME=1h
# TREND_REGIME_TIMEFRAME=4h
# true = the strategy also opens SHORT trades (exact mirror of the long rules). Off by default:
# compare in a backtest first (strategyParams: { "allowShort": 1 }). Shorts only execute in PAPER;
# Binance Spot (LIVE) can't short, so risk vetoes them there with SHORT_NOT_SUPPORTED.
TREND_ALLOW_SHORT=true
# Research filters, off (0) by default: test them in a backtest (strategyParams) before turning on.
# ADX(TREND_ADX_PERIOD) on the regime timeframe must be >= TREND_ADX_MIN to enter (E5: 20).
# TREND_ADX_PERIOD=14
# TREND_ADX_MIN=0
# Regime band: up only when close > EMA × (1 + band), down only below EMA × (1 − band). 0.01 = 1%.
# TREND_REGIME_BAND_PCT=0

# --- RiskManager ---
# RISK_PER_TRADE_PCT=0.01
# RISK_MAX_OPEN_POSITIONS=3

# --- ExecutionModule ---
# Off by default even in PAPER mode — an extra explicit opt-in before the automated loop runs.
EXECUTION_ENABLED=false
EXECUTION_POLL_INTERVAL_SECONDS=60
EXECUTION_RECONCILIATION_INTERVAL_MINUTES=15
EXECUTION_STOP_LIMIT_OFFSET_PCT=0.001
# PAPER/LIVE equity curve: one snapshot (cash + open positions at last price) every N minutes.
EQUITY_SNAPSHOT_INTERVAL_MINUTES=5

# --- ControlModule ---
# Required to call POST /bot/pause, /resume, /kill-switch via header X-Control-Api-Key.
# Leave empty during local dev; set it before exposing the API anywhere reachable.
CONTROL_API_KEY=
# true = EVERY route except /health needs X-Control-Api-Key (public host, e.g. Render).
# Requires CONTROL_API_KEY (min 32 chars). The dashboard proxy already sends it.
API_KEY_REQUIRED_FOR_ALL=false
# false = no Swagger UI at /docs (recommended on a public host).
SWAGGER_ENABLED=true

# --- Notifications (optional) ---
# Every notification is always logged; channels below are extra. A channel failure (timeout, 5xx,
# rate limit) is logged and never affects trading.
# Discord: create a webhook (Server Settings > Integrations > Webhooks) and paste its URL.
# The URL contains a secret token: never commit it.
DISCORD_ENABLED=false
DISCORD_WEBHOOK_URL=
DISCORD_USERNAME=Trade Bot
# Comma-separated: alerts (critical/pause/resume) and/or trades (opened/closed).
DISCORD_EVENTS=alerts,trades
# Telegram: on as soon as token + chat id are set (TELEGRAM_ENABLED=false turns it off).
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_EVENTS=alerts
# Per HTTP attempt (Discord/Telegram).
NOTIFICATIONS_TIMEOUT_MS=5000

# --- Funding scanner (read-only, never places orders) ---
FUNDING_SCAN_ENABLED=true
FUNDING_BASE_URL=https://fapi.binance.com

# --- Redis (cache for reports/charts, so dashboards don't hit Mongo on every request) ---
# Upstash (TLS): rediss://default:<UPSTASH_REDIS_REST_TOKEN>@<host>.upstash.io:6379 (Upstash
# console > Connect > ioredis). Local alternative: redis://localhost:6379 (or redis://redis:6379
# in Docker Compose). Purely a performance optimization: if Redis is down/unreachable, the app
# logs a warning and falls back to querying Mongo directly.
# Set it empty (REDIS_URL=) to disable the cache entirely.
REDIS_ENABLED=true
REDIS_URL=rediss://default:<upstash-token>@<your-db>.upstash.io:6379
REPORTS_CACHE_TTL_SECONDS=30
# A hung Redis costs at most this per request before falling back to Mongo.
REDIS_COMMAND_TIMEOUT_MS=500
REDIS_CONNECT_TIMEOUT_MS=2000
# Reconnect attempts (backoff up to 30s) before giving up; then one re-probe every 5 min.
REDIS_MAX_RECONNECT_ATTEMPTS=10

# --- OpenAI Agents (optional: analysis/explanations only, never places or closes trades) ---
# POST /ai/agents/:agent/run (needs X-Control-Api-Key when CONTROL_API_KEY is set).
# Enabling without OPENAI_API_KEY makes the boot fail (fail-fast, like LIVE mode).
OPENAI_AGENTS_ENABLED=false
OPENAI_API_KEY=
# Empty = the Agents SDK default model.
OPENAI_MODEL=
OPENAI_REQUEST_TIMEOUT_MS=30000
OPENAI_MAX_RETRIES=2
OPENAI_AGENT_TIMEOUT_MS=90000
OPENAI_AGENT_MAX_TURNS=8
OPENAI_MAX_CONCURRENT_RUNS=2
# Off by default: traces would send prompts and trading data to the OpenAI dashboard.
OPENAI_TRACING_ENABLED=false
